<?xml version="1.0" encoding="UTF-8"?>
<!-- NameServer 进程日志配置。仓内主码统一走 log4j-api；这份配置只随可执行产物存在，
     库形态（z-mq-nameserver 正常 jar）里没有它，行为不变。 -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1.} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.zifang.z.mq" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
