<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-opc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Maven Central 用 io.github.yuku123（已通过 Sonatype namespace 验证）
         显式覆盖 parent 的 com.zifang，保留 parent 仅用于继承 monorepo 本地构建链 -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-mq</artifactId>
    <version>1.2.1</version>
    <packaging>pom</packaging>

    <name>z-mq</name>
    <description>Zero-copy broker + Nameserver + Spring Boot Starter 的轻量级分布式消息队列基础设施</description>
    <url>https://github.com/yuku123/z-mq</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-mq.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-mq.git</developerConnection>
        <url>https://github.com/yuku123/z-mq</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-mq-common</module>
        <module>z-mq-remoting</module>
        <module>z-mq-store</module>
        <module>z-mq-nameserver</module>
        <module>z-mq-broker</module>
        <module>z-mq-client</module>
        <module>z-mq-spring-boot-starter</module>
        <module>z-mq-tools</module>
    </modules>

    <properties>
        <!-- Java Version -->
        <java.version>8</java.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency Versions -->
        <netty.version>4.1.108.Final</netty.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <jackson-bom.version>2.18.6</jackson-bom.version>
        <slf4j.version>2.0.12</slf4j.version>
        <log4j2.version>2.25.4</log4j2.version>
        <logback.version>1.5.34</logback.version>
        <fastjson2.version>2.0.47</fastjson2.version>
        <guava.version>33.6.0-jre</guava.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>

        <!-- Test Dependencies -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>4.11.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>

        <!-- Plugin Versions -->
        <maven-compiler-plugin.version>3.12.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <jacoco-maven-plugin.version>0.8.11</jacoco-maven-plugin.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-remoting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-broker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-nameserver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
            <artifactId>z-mq-tools</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Log4j2 BOM —— 必须排在 spring-boot-dependencies 之前。
                 import 进来的 BOM 无法用 property 覆盖，而 boot 2.7.18 把 log4j2 钉在 2.17.2：
                 模块只用 log4j-api 2.25.4、传递进来的 log4j-core 却被压到 2.17.2，
                 两者一撞就是 NoSuchMethodError: LoaderUtil.getClassLoaders()（类初始化即失败，整套件跑不进 JVM）。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jackson BOM —— 同样必须排在 spring-boot-dependencies 之前。
                 不钉它时 core/annotations 由谁决定要看父 pom：250 上 8 月那份 z-opc 父 pom 零条 jackson 声明，
                 core 被 Boot 压到 2.13.5 而 databind 仍是模块自钉的 2.18.6，
                 结果 NoSuchMethodError: BufferRecycler.releaseToPool()（z-mq-common 8 例全红）。
                 import BOM 后三件套一起出 2.18.6，模块里的显式 <version> 也就没必要再留。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Netty BOM —— 必须排在 spring-boot-dependencies 之前：实测把 import 放在 Boot 之后会输，
                 同一个 pom 里先声明的 import 才赢（下面是量出来的结论，不是推测）。
                 只钉 io.netty:netty-all 也不够：netty-all 4.1.108 的 jar 实测 4516 字节、0 个 class，
                 真正的类全在它带的 30 个分件里，而分件被 Boot 2.7.18 改写成 4.1.101 ——
                 即"升到 4.1.108"从未生效，101→108 之间的修复一个没拿到。 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JUnit BOM —— 同样必须排在 spring-boot-dependencies 之前。
                 junit-jupiter 聚合壳钉 5.10.2 而 jupiter-api/engine/params 被 Boot 压到 5.8.2，
                 实际跑的始终是 5.8.2（dependency:tree 里 5.10.2 的 api 一个都不存在）。 -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Netty -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Utilities -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <!-- Test Dependencies -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全模块测试期共用的 log4j2 绑定。
             主码只用 log4j-api（不打绑定进构件，绑定归下游应用），但 49 个主源文件在 <clinit> 里
             LogManager.getLogger(...) —— 测试没有 core 就是整类 NoClassDefFoundError，不是少打日志。 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-Xmx1024m -XX:MaxMetaspaceSize=256m</argLine>
                        <trimStackTrace>false</trimStackTrace>
                        <!-- 挂钟阈值断言（"10 us/op 以内"）不做默认门禁：同一份代码两次跑一次红一次绿，
                             而它一红就让整个 reactor 从第 2 个模块起中断，后面 6 个模块的测试根本不执行。
                             要看吞吐用 `mvn test -Pperf` 显式跑。 -->
                        <excludes>
                            <exclude>**/*BenchmarkTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <argLine>-Xmx1024m -XX:MaxMetaspaceSize=256m</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- 吞吐/挂钟基准：只在显式 `-Pperf` 时跑（默认被 surefire 的 excludes 挡在门禁外） -->
        <profile>
            <id>perf</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>central</id>
            <properties>
                <!-- true 跳过 javadoc（仅用于本地 dry-run）；真发 Central 必须 false（Central 强制要求 javadoc.jar） -->
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <!-- true 跳过 GPG 签名（用于本地 dry-run）；真发 Central 时改为 false -->
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 发布用的 pom 必须自包含：本仓的 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT，
                         它永远不会（也不能）出现在 Central 上。带着这个 parent 发出去的构件，
                         任何外部消费者第一次解析就报
                         "Could not find artifact com.zifang:z-opc:pom:1.0.0-SNAPSHOT"，
                         等于构件全废。flatten 在 process-resources 生成去掉 parent、
                         并把继承来的版本全部写死的 pom，install/deploy 用它替换（updatePomFile）。
                         本地 monorepo 构建链不受影响：不带 -P central 时不执行。
                         （同款已先在 z-cache 1.3.3/1.3.4 验证： Central 上的 starter pom <parent> 计数 = 0） -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <inherited>true</inherited>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>oss</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten.clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 中央发布场景下，禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- sources.jar：central-publishing-maven-plugin 要求 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Maven Central 强制要求 javadoc.jar；doclint=none 规避 Java 8+ HTML5 校验 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <source>${java.version}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG 签名：passphrase 通过环境变量 CENTRAL_GPG_PASSPHRASE 传入 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <!-- 显式传 pinentry-mode loopback + no-tty，让 mvn-gpg-plugin
                                 在 sandbox / 无 gpg-agent 环境也能签名 -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传插件 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
