# z-mq NameServer 镜像（lead 005 §1.3 部署层）
#
# z-mq 与规范里的 z-{m}-admin 模型不同：仓内没有 admin 模块，而是两个各自带 main() 的
# 独立进程（NameServerStartup / BrokerStartup），所以这里出两份 Dockerfile 而不是
# Dockerfile.backend 一份。两份共用同一个 builder 段，只有 mainClass/端口/数据卷不同。
#
# 可执行 jar 来自 maven-shade-plugin 的 classifier=exec 产物（见
# z-mq-nameserver/pom.xml）：无它就得在容器里手工 java -cp 拼 classpath。
#
# 构建上下文 = **本仓根目录**（需要根 pom + 各模块源码）：
#   docker build -f deploy/Dockerfile.nameserver -t z-mq-nameserver:local .
# 基础镜像走 build-arg：默认是官方坐标，但本网络内 Docker Hub 不可达
# （auth.docker.io i/o timeout），需要时用 --build-arg 换成可达的镜像站前缀，
# 不要把某个镜像站硬写进 FROM，那样换网络就是一处硬失败。
ARG BUILDER_BASE=maven:3.9.9-eclipse-temurin-8
ARG RUNTIME_BASE=eclipse-temurin:8-jre

FROM ${BUILDER_BASE} AS builder

WORKDIR /build

# 根 pom 的 <modules> 列了全部 9 个模块，Maven 在解析 reactor 阶段就要求
# 它们**都在**上下文里，缺一个直接 ProjectBuildingException，连 -pl 都进不去。
COPY ./pom.xml ./pom.xml
COPY ./z-mq-common ./z-mq-common
COPY ./z-mq-remoting ./z-mq-remoting
COPY ./z-mq-store ./z-mq-store
COPY ./z-mq-common ./z-mq-common
COPY ./z-mq-remoting ./z-mq-remoting
COPY ./z-mq-store ./z-mq-store
COPY ./z-mq-nameserver ./z-mq-nameserver
COPY ./z-mq-broker ./z-mq-broker
COPY ./z-mq-client ./z-mq-client
COPY ./z-mq-spring-boot-starter ./z-mq-spring-boot-starter
COPY ./z-mq-tools ./z-mq-tools
COPY ./z-mq-broker-admin ./z-mq-broker-admin

RUN mvn -f pom.xml -pl z-mq-nameserver -am clean package \
        -DskipTests \
        -Dmaven.javadoc.skip=true \
        -q

FROM ${RUNTIME_BASE}

LABEL maintainer="zifang"
LABEL description="z-mq NameServer"

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

RUN useradd --system --uid 10002 zmq && mkdir -p /data/namesrv && chown -R zmq:zmq /data
USER 10002

WORKDIR /app

# 正常 jar 是库形态（不以 -exec 结尾），glob 只会命中 shade 那份
COPY --from=builder /build/z-mq-nameserver/target/z-mq-nameserver-*-exec.jar /app/nameserver.jar

ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"
ENV ZMQ_NAMESRV_PORT="9876"
# ⚠ bind host 必须**显式**声明，不能靠默认值。
# NettyServerConfig 的默认 bind host 是回环（127.0.0.1）—— z-mq 的 Netty 面走私有二进制
# 协议且**协议层没有认证**，绑通配地址等于把"可读写"开放给整个局域网。
# 但容器化部署要靠 Service / NodePort 被访问（Service 选的是 Pod IP，不是容器内的回环），
# 所以这一形态必须显式声明 0.0.0.0。默认回环 + 部署形态显式声明，是这里的两条规矩。
ENV ZMQ_SERVER_HOST="0.0.0.0"
# NameServerStartup 的第二个位置参数是 KV 配置路径；不给就用 NamesrvConfig 里的默认值，
# 而那个默认值是硬编码的开发机绝对路径（~/zmq/namesrv/kvConfig.json），容器里不存在 ⇒ 必须显式传。
ENV ZMQ_NAMESRV_KV_CONFIG="/data/namesrv/kvConfig.json"

# 9876 = Netty 长连接（路由注册/拉取）
EXPOSE 9876

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/${ZMQ_NAMESRV_PORT}'

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/nameserver.jar $ZMQ_NAMESRV_PORT $ZMQ_NAMESRV_KV_CONFIG"]
