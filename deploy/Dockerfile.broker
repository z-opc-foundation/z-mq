# z-mq Broker 镜像（lead 005 §1.3 部署层）
#
# 与 Dockerfile.nameserver 共用 builder，差异只有 mainClass / 端口 / 数据卷。
# BrokerStartup 的位置参数是 [brokerPort] [namesrvAddr] [storePathRootDir]，三个都由环境变量传。
#
# 构建上下文 = **本仓根目录**：
#   docker build -f deploy/Dockerfile.broker -t z-mq-broker:local .
# 基础镜像走 build-arg：默认是官方坐标，但本网络内 Docker Hub 不可达
# （auth.docker.io i/o timeout），需要时用 --build-arg 换成可达的镜像站前缀，
# 不要把某个镜像站硬写进 FROM，那样换网络就是一处硬失败。
ARG BUILDER_BASE=maven:3.9.9-eclipse-temurin-8
ARG RUNTIME_BASE=eclipse-temurin:8-jre

FROM ${BUILDER_BASE} AS builder

WORKDIR /build

# 根 pom 的 <modules> 列了全部 9 个模块，Maven 在解析 reactor 阶段就要求
# 它们**都在**上下文里，缺一个直接 ProjectBuildingException，连 -pl 都进不去。
COPY ./pom.xml ./pom.xml
COPY ./z-mq-common ./z-mq-common
COPY ./z-mq-remoting ./z-mq-remoting
COPY ./z-mq-store ./z-mq-store
COPY ./z-mq-common ./z-mq-common
COPY ./z-mq-remoting ./z-mq-remoting
COPY ./z-mq-store ./z-mq-store
COPY ./z-mq-nameserver ./z-mq-nameserver
COPY ./z-mq-broker ./z-mq-broker
COPY ./z-mq-client ./z-mq-client
COPY ./z-mq-spring-boot-starter ./z-mq-spring-boot-starter
COPY ./z-mq-tools ./z-mq-tools
COPY ./z-mq-broker-admin ./z-mq-broker-admin

RUN mvn -f pom.xml -pl z-mq-broker -am clean package \
        -DskipTests \
        -Dmaven.javadoc.skip=true \
        -q

FROM ${RUNTIME_BASE}

LABEL maintainer="zifang"
LABEL description="z-mq Broker"

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

RUN useradd --system --uid 10002 zmq && mkdir -p /data/store && chown -R zmq:zmq /data
USER 10002

WORKDIR /app

COPY --from=builder /build/z-mq-broker/target/z-mq-broker-*-exec.jar /app/broker.jar

ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
ENV ZMQ_BROKER_PORT="10911"
# compose/k8s 里覆盖成 http://<nameserver-service>:9876 之类
ENV ZMQ_NAMESRV_ADDR="127.0.0.1:9876"
ENV ZMQ_STORE_PATH="/data/store"
# 对外公布的 Broker 地址主机名。留空 = 用 BrokerConfig 默认的 localhost，
# 那只对"客户端与 broker 同机"成立；跨机/跨容器必须显式给可路由的值，
# 否则 NameServer 路由表里存的是客户端自己的回环地址，客户端永远连不上。
ENV ZMQ_BROKER_IP1=""

# 10911 = Broker Netty 长连接（生产/消费/拉取）
EXPOSE 10911

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/${ZMQ_BROKER_PORT}'

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/broker.jar $ZMQ_BROKER_PORT $ZMQ_NAMESRV_ADDR $ZMQ_STORE_PATH $ZMQ_BROKER_IP1"]
