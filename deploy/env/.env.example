# z-mq compose 环境变量样例（lead/006 占位符规范：只放占位符，不放真值）
# 复制成 .env 后按需覆盖。z-mq 本身无凭据类配置，这里主要是端口与路径。

ZMQ_NAMESRV_PORT=9876
ZMQ_BROKER_PORT=10911
ZMQ_NAMESRV_KV_CONFIG=/data/namesrv/kvConfig.json
ZMQ_STORE_PATH=/data/store

# JVM
ZMQ_NAMESRV_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
ZMQ_BROKER_JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
