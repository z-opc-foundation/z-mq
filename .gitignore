# ===== Git 本地备份目录 (历史塌缩用) =====
.git.bak.*/

# flatten-maven-plugin 常开：每次本地构建在根和各模块目录留下展平后的 pom
*.flattened-pom.xml
.flattened-pom.xml

/.cache/
**/__pycache__/
*.pyc
_frontend/**/node_modules/
z-mq-admin/node_modules/
z-mq-admin/dist/
# vue-tsc -b / tsc -b 往源码树里吐的编译产物（vite.config.js 就是这么来的）
*.tsbuildinfo
z-mq-admin/vite.config.js
z-mq-admin/vite.config.d.ts
# 控制台镜像的构建输入：build-admin-dist.sh 的产物，随镜像走不进 git
deploy/admin-dist/

# ============ vite 构建旧产物（沙箱删除闸 ⇒ 只移不删，遗留带时间戳的兄弟目录） ============
dist.stale-*/
**/dist.stale-*/
dist.bak-*/
**/dist.bak-*/

# ---- 构建产物治理（2026-11-03）----
# 编译/打包产物一律不入库：可再生、体积大、多仓重复。
# Rust target / 前端 node_modules / Python 缓存。
node_modules/

# 前端组件库 dist/：vite build 产物（public/ 才是源文件）。
# npm publish 前必须先 npm run build，否则发出去是空包。
_frontend/**/dist/
dist/
